{
  "name": "china-ai-observatory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node --import tsx scripts/build.ts",
    "preview": "wrangler pages dev dist",
    "validate": "node --import tsx src/validate.ts",
    "test": "node --import tsx --test tests/content.test.ts tests/filters.test.ts tests/changelog.test.ts",
    "test:filter": "node --import tsx tests/filter-smoke.ts",
    "test:mobile": "node --import tsx tests/mobile-smoke.ts",
    "test:changelog": "node --import tsx --test tests/changelog.test.ts",
    "briefing": "node --import tsx scripts/prepare-briefing.ts",
    "deploy": "node --import tsx scripts/deploy.ts",
    "test:ui": "node --import tsx tests/run-ui.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "playwright": "^1.60.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.80.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12",
    "astro": "^5.18.1",
    "glob": "^10.3.0",
    "yaml": "^2.3.0",
    "zod": "^3.22.0"
  }
}
